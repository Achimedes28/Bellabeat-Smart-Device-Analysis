        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "% of Users"
                }
              },
              "queryRef": "Measures.% of Users",
              "nativeQueryRef": "% of Users"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Users"
                  }
                },
                "Property": "Segment"
              }
