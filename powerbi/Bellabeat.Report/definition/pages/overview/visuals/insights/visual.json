                  {
                    "value": "Key insights",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#1F2937"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "About a third of users are sedentary (12 of 34). ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1F2937"
                    }
                  },
                  {
                    "value": "Position Bellabeat as a micro-habit coach, not workout gear.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#6B7280"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "15.7 sedentary hours per worn day. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1F2937"
                    }
                  },
                  {
                    "value": "Includes unlogged sleep; about 32 minutes of moderate-to-vigorous activity.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#6B7280"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "13% of days show zero steps. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1F2937"
                    }
                  },
                  {
                    "value": "The device is often not worn; lead with comfort (Leaf).",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#6B7280"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Tuesday is the low point (6.0k steps). ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#1F2937"
                    }
                  },
                  {
                    "value": "Use it for reminders and step challenges.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#6B7280"
                    }
                  }
                ]
              }
            ]
